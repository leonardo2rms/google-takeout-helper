# Enables AI grading of open questions. Without it the app still works: open questions
# fall back to a keyword pre-check + self-assessment against the model answer.
ANTHROPIC_API_KEY=

# Optional
# GRADER_MODEL=claude-opus-5-5     # e.g. claude-sonnet-5-5 or claude-haiku-5-5 for cheaper/faster grading
# GRADER_EFFORT=low                # low | medium | high
# PORT=8787
